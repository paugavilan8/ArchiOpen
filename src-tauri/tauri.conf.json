{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchiOpen",
  "version": "0.1.0",
  "identifier": "io.github.paugavilan8.archiopen",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev -- --port 5273 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ArchiOpen",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Open source NURBS modeler",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["archi"],
        "name": "ArchiOpen model",
        "description": "ArchiOpen model",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ]
  }
}
